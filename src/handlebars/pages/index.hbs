<div class="container main-wrapper">
  <div class="welcome-header">
    <h1>Welcome to Last Rev's Services Status Page</h1>
  </div>
  <div class="welcome-sub-header">
    <p>
      In order to provide you with a better experience. We have created a status page that will allow you to easily see the status of the services Last Rev uses to keep your business up and running effeciently.
    </p>
  </div>
  <div class="container d-flex mb-4">
    <div class="row col-md-6">
      <div class="mb-2">
        <span class="legend-icon-green">No Scheduled Maintenance and No Events Reported within 24 hours.</span>
      </div>
      <div class="mb-2">
        <span class="legend-icon-yellow">Incidents/Events reported within the previous 12 hours.</span>
      </div>
    </div>
      <div class="row col-md-6 ml-3">
        <div class="mb-2">
          <span class="legend-icon-red">Incidents/Events reported within the previous 3 hours.</span>
        </div>
        <div class="">
          <span class="legend-icon-blue">Planned Maintenance/Events</span>
        </div>
      </div>
  </div>
</div>
  <div>
    <div class="container mb-4 main-content-wrapper">
      <div id="accordion" class="accordion">

          {{!-- BEGIN Status Cards --}}
        {{#each pageData.services}}
        <div class="card mb-3 border">
          <div class="card-header collapsed {{this.issueClassColor}}" data-toggle="collapse" href="#{{this.serviceId}}Status">
              <img class='mr-3' src="{{this.serviceLogo}}" height='50' width="50" alt="">
              <a class="card-title">{{this.serviceName}}</a>
              {{#each (pullArray array=this.issues amount=1)}}
                <div class="mt-2">
                  {{#if this}}
                    Most Recent Incident occurred on {{this.pubDate}}
                  {{else}}
                    There have been no recent incidents.
                  {{/if}}
                </div>
              {{/each}}
          </div>
          <div id="{{this.serviceId}}Status" class="card-body card-body-wrapper collapse" data-parent="#accordion">
            <div class="text-center">
              <p>Click the button below to find more information about the current status of {{this.serviceName}}</p>
              <a href="{{this.serviceURL}}" target="_blank"><button type="button" class="btn btn-primary services-btns mb-3">{{this.serviceName}} Status Page</button></a>
            </div>

            <div class="mb-4">
              {{#if this.issues.length}}
                {{#each (pullArray array=this.issues amount=5)}}
                  <div class="container">
                    <div class="row my-auto incidents-wrapper">
                      <div class="col-9 col-sm-11 d-flex align-items-center">
                        <div class="py-2">
                          <div>
                            <strong><em>{{{this.pubDate}}}&nbsp;{{this.pubTime}} PST</em></strong>
                            {{!-- BEGIN Columns used only for Heroku because we can see the current status of an incident --}}
                            {{#if this.isHerokuFeed}}
                              <div class="py-2">
                                {{this.title}}
                              </div>
                            {{/if}}
                            {{!-- END Columns used only for Heroku because we can see the current status of an incident --}}
                            {{!-- BEGIN Columns used only for Atlassian Feeds, no status state available--}}
                            {{#if this.isAtlassianFeed}}
                              <div class="py-2">
                                {{this.title}}
                              </div>
                            {{/if}}
                            {{!-- END Columns used only for Atlassian Feeds, no status state available--}}
                          </div>
                        </div>
                      </div>
                      <div class="col-3 col-sm-1 border-right-0 d-flex align-items-center p-0">
                        <a class='mx-auto more-info-btn collapsed' data-toggle="collapse" href="#issue-{{this.id}}" aria-expanded="false" aria-controls="issue-{{this.id}}"></a>
                      </div>
                    </div>
                    <div class="collapse" id="issue-{{this.id}}">
                      <div class="container py-0">
                        {{!-- BEGIN normalizeHerokuFeed - Heroku Issues Feed Only --}}
                        {{#if this.isHerokuFeed}}
                          {{#each this.updates}}
                            <div class="row">
                              <div class="col-12 py-3">
                                <div>
                                  <strong>{{this.pubDate}}&nbsp;{{this.pubTime}} PST</strong>
                                </div>
                                <div>
                                  <span class='text-capitalize text-primary'><strong>{{this.state}}</strong></span> - {{this.title}}
                                </div>
                              </div>
                            </div>
                          {{/each}}
                        {{/if}}
                        {{!-- END normalizeHerokuFeed - Heroku Issues Feed Only --}}

                        {{!-- BEGIN All normalizeRssFeed's Data from content, Clients Using Jira Status Page --}}
                        {{#if this.isAtlassianFeed}}
                        <div class="isAtlassianFeed">
                          {{{this.content}}}
                        </div>
                        {{/if}}
                        {{!-- END All normalizeRssFeed's Data, Clients Using Jira Status Page --}}
                      </div>
                    </div>
                  </div>
                {{/each}}
              {{else}}
                <div class="container">
                  <div class="row my-auto incidents-wrapper">
                    <div class="col-12 d-flex align-items-center justify-content-center my-3">
                      No recent incidents to display.
                    </div>
                  </div>
                </div>
              {{/if}}
            </div>
          </div>
        </div>
        {{!-- END Status Cards --}}
        {{/each}}
      </div>
    </div>
  </div>
</div>
