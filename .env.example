# Public site URL (used for canonical URLs, OG tags, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://status.tcs.repair

# Sanity is optional. Leave PROJECT_ID empty to use in-repo SEED_SERVICES + DEFAULT_SETTINGS.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only Sanity read token (only needed for drafts / private datasets).
SANITY_READ_TOKEN=

# Secret guarding the /api/revalidate webhook endpoint (Sanity webhook).
SANITY_REVALIDATE_SECRET=
