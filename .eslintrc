{
  "env": {
    "browser": true,
    "node": true,
    "es6": true,
    "jquery": true
  },
  "extends": [
    "airbnb-base",
    "prettier"
  ],
  "rules": {
    "no-param-reassign": [2, { "props": false }],
    "no-plusplus": ["error", { "allowForLoopAfterthoughts": true }],
    "max-len": ["error", {
      "comments": 200,
      "code": 120,
      "ignoreUrls": true,
      "ignoreStrings": true
    }],
    "arrow-body-style": ["error", "as-needed"],
    "import/no-extraneous-dependencies": ["error", {
      "devDependencies": [
        "webpack/**.js",
        "test/**/**.js",
        "migrations/**/**.js",
        "build_scripts/**/**.js"
      ]
    }],
    "quotes": ["error", "single"],
    "comma-dangle": ["error", "always-multiline"],
    "arrow-parens": ["error", "as-needed"]
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "ecmaFeatures": {
      "legacyDecorators": true
    }
  },
  "globals": {
    "_": true,
    "DOMPurify": true
  }
}
