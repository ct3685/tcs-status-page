{
  "name": "tcs-status-page",
  "version": "2.0.0",
  "private": true,
  "description": "TCS Repair Services Status Page - Next.js + Netlify",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:secure": "pnpm secure-run next dev",
    "build:secure": "pnpm secure-run next build",
    "start:secure": "pnpm secure-run next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx --env-file=.env scripts/seed-sanity.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secure-run": "node ./scripts/bws-secure/secureRun.js",
    "list-projects": "node ./scripts/bws-secure/list-projects.js",
    "bws-deps": "[ -d node_modules/dotenv ] && [ -d node_modules/dotenv-cli ] && [ -f node_modules/.bin/bws ] || npm install",
    "bws-update": "rm -rf scripts/bws-secure && git clone git@github.com:last-rev-llc/bws-secure.git scripts/bws-secure && rm -rf scripts/bws-secure/.git && bash scripts/bws-secure/install.sh",
    "postinstall": "sh ./scripts/bws-secure/bws-installer.sh"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "@mui/material-nextjs": "^9.1.1",
    "@netlify/blobs": "^10.7.9",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.1.0",
    "fast-xml-parser": "^5.9.2",
    "next": "^16.2.9",
    "next-sanity": "^13.1.0",
    "p-limit": "^7.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sanitize-html": "^2.17.5",
    "sanity": "^6.1.0",
    "styled-components": "^6.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@netlify/plugin-nextjs": "latest",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "yargs": "^18.0.0",
    "glob": "^13.0.6",
    "axios": "^1.15.1"
  }
}
