{
  "name": "express-hbs-app-starter",
  "version": "1.0.0",
  "description": "starter project for express and handlebars",
  "main": "index.js",
  "scripts": {
    "build:clean": "rimraf public",
    "build:docs": "node ./build_scripts/docs",
    "build:eslint:server": "./node_modules/.bin/eslint --ext js ./src/server",
    "build:eslint:client": "./node_modules/.bin/eslint --ext js client",
    "build:webpack:prod": "npm run-script build:clean && webpack --progress --config build_scripts/webpack/webpack.config.prod.js",
    "build:webpack:dev": "npm run-script build:clean && webpack --watch --progress --config build_scripts/webpack/webpack.config.dev.js",
    "start:debug": "npm test && concurrently \"npm:build:webpack:dev\" \"npm:start:server:debug\"",
    "start:prod": "pm2-runtime start ecosystem.config.js",
    "start:server:dev": "nodemon -r dotenv/config ./build_scripts/www",
    "start:server:debug": "nodemon -r dotenv/config --inspect ./build_scripts/www",
    "heroku-postbuild": "npm run-script build:webpack:prod",
    "test": "jest",
    "start": "npm test && concurrently \"npm:build:webpack:dev\" \"npm:start:server:dev\""
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/preset-env": "^7.5.5",
    "@sentry/webpack-plugin": "^1.7.0",
    "babel-jest": "^24.8.0",
    "concurrently": "^4.1.1",
    "copy-webpack-plugin": "^5.0.3",
    "css-loader": "^3.1.0",
    "dotenv": "^8.0.0",
    "eslint": "^6.0.1",
    "eslint-config-airbnb-base": "^13.2.0",
    "eslint-loader": "^2.2.1",
    "eslint-plugin-import": "^2.18.2",
    "jest": "^24.8.0",
    "markdown-magic": "^0.1.25",
    "markdown-magic-dependency-table": "^1.3.2",
    "markdown-magic-jsdoc": "^1.0.1",
    "mini-css-extract-plugin": "^0.8.0",
    "node-sass": "^4.12.0",
    "nodemon": "^1.19.1",
    "optimize-css-assets-webpack-plugin": "^5.0.3",
    "sass-loader": "^7.1.0",
    "uglifyjs-webpack-plugin": "^2.1.3",
    "webpack": "^4.36.1",
    "webpack-cli": "^3.3.6",
    "webpack-dev-middleware": "^3.7.0",
    "webpack-hot-middleware": "^2.25.0",
    "webpack-merge": "^4.2.1"
  },
  "dependencies": {
    "@sentry/node": "^5.5.0",
    "body-parser": "^1.19.0",
    "bootstrap": "^4.3.1",
    "contentful": "^7.8.2",
    "cookie-parser": "^1.4.4",
    "express": "^4.17.1",
    "express-handlebars": "^3.1.0",
    "express-winston": "^3.2.1",
    "flat": "^4.1.0",
    "handlebars": "^4.1.2",
    "handlebars-helpers": "^0.10.0",
    "helmet": "^3.19.0",
    "jquery": "^3.4.1",
    "lodash": "^4.17.15",
    "morgan": "^1.9.1",
    "pm2": "^3.5.1",
    "popper.js": "^1.15.0",
    "winston": "^3.2.1"
  }
}
