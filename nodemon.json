{
  "restartable": "rs",
  "ignore": [
    ".git",
    "node_modules/**/node_modules"
  ],
  "verbose": false,
  "events": {
    "restart": "osascript -e 'display notification \"App restarted due to:\n'$FILENAME'\" with title \"nodemon\"'"
  },
  "watch": [
    "src/server/**/**",
    "src/handlebars/helpers/**",
    "src/app.js",
    ".env"
  ],
  "env": {
    "NODE_ENV": "development"
  },
  "ext": "js json"
}